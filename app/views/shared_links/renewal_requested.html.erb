<% content_for :title, "Request received - DocumentFlow" %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="flex items-center gap-2 mb-8">
    <%= image_tag "icon.png", class: "w-8 h-8", alt: "" %>
    <span class="text-xl font-bold text-gray-900">DocumentFlow</span>
  </div>

  <%= render Ui::CardComponent.new do %>
    <%= render Ui::EmptyStateComponent.new(
      title: "Request received",
      description: "If that email address is associated with this document, we've sent a new link to it. Please check your inbox."
    ) %>
  <% end %>
</div>
