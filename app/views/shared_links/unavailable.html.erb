<% content_for :title, "Link unavailable - DocumentFlow" %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="flex items-center gap-2 mb-8">
    <svg class="w-8 h-8 text-primary-600" fill="currentColor" viewBox="0 0 24 24">
      <path d="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z"/>
    </svg>
    <span class="text-xl font-bold text-gray-900">DocumentFlow</span>
  </div>

  <%= render Ui::CardComponent.new do %>
    <%= render Ui::EmptyStateComponent.new(
      title: "This link is no longer available",
      description: "The share link you followed has expired or does not exist. Please ask the sender for a new link."
    ) %>
  <% end %>

  <% if @shared_link && @shared_link.document.shared_link_renewed_at.nil? %>
    <div class="mt-6">
      <%= render Ui::CardComponent.new do |card| %>
        <% card.with_header { "Request a new link" } %>

        <p class="text-sm text-gray-600 mb-4">
          Enter the email address this document was shared with, and if it matches, we'll send you a new link.
        </p>

        <%= form_with url: renew_shared_document_path(token: @shared_link.token), method: :post, local: true, class: "flex flex-col sm:flex-row gap-3" do |f| %>
          <%= f.email_field :email, required: true, placeholder: "you@example.com",
                class: "flex-1 rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm" %>
          <%= render Ui::ButtonComponent.new(type: "submit") do %>
            Send me a new link
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% elsif @shared_link %>
    <div class="mt-6">
      <%= render Ui::CardComponent.new do %>
        <%= render Ui::EmptyStateComponent.new(
          title: "You've already requested a new link",
          description: "Only one renewal is allowed per document. Please contact the sender if you still need access."
        ) %>
      <% end %>
    </div>
  <% end %>
</div>
