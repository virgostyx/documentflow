<td class="px-4 py-3 text-gray-700"><%= link_to job.queue_name, application_queue_path(@application, job.queue), class: "text-primary-600 hover:text-primary-700" %></td>
<td class="px-4 py-3">
  <div class="font-mono text-xs text-gray-700"><%= job.blocked_by %></div>
  <div class="text-gray-500 text-xs"><%= job.blocked_until ? "Expires #{bidirectional_time_distance_in_words_with_title(job.blocked_until)}" : "" %></div>
</td>
<td class="px-4 py-3 text-right">
  <%= render "mission_control/jobs/jobs/blocked/actions", job: job %>
</td>
