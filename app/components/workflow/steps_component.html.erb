<%= render Ui::CardComponent.new do |card| %>
  <% card.with_header { "Validation circuit" } %>

  <% if steps.any? %>
    <% sortable_data = manageable? ? { controller: "sortable-steps", sortable_steps_url_value: reorder_entity_document_workflow_steps_path(document.entity, document) } : {} %>
    <%= tag.div class: "divide-y divide-gray-100", data: sortable_data do %>
      <% steps.each do |step| %>
        <div data-step-id="<%= step.id %>">
          <%= render Workflow::StepComponent.new(step: step, manageable: manageable?, reassignable: reassignable?(step)) %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <p class="text-sm text-gray-500">No validation circuit defined for this document yet.</p>
  <% end %>

  <% if manageable? %>
    <%= render Workflow::AddStepFormComponent.new(document: document) %>
    <%= render Workflow::ApplyTemplateFormComponent.new(document: document) %>
  <% end %>
<% end %>
