<% list_scope_label = { "mine" => "My Outbox", "received" => "My Inbox", "todo" => "ToDo", "waiting" => "Waiting", "info" => "Info", "to_validate" => "To Validate" }.fetch(@list_scope, "Overview") %>

<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: "Documents", path: entity_documents_path(current_entity) },
    { label: list_scope_label }
  ]) %>
<% end %>

<% content_for :actions do %>
  <% if policy(current_entity.documents.new).create? %>
    <%= render(Ui::ButtonComponent.new(href: new_entity_document_path(current_entity))) { "New document" } %>
  <% end %>
<% end %>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
  <%= form_with url: search_entity_documents_path(current_entity), method: :get, local: true,
                data: { turbo_frame: "documents_list" }, class: "flex-1 max-w-md" do %>
    <input type="hidden" name="scope" value="<%= @list_scope %>">
    <input type="hidden" name="classification_node_id" value="<%= params[:classification_node_id] %>">
    <input type="search" name="q" value="<%= params[:q] %>" placeholder="Search documents..."
           class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
  <% end %>

  <%= render Ui::FilterPanelComponent.new(active_count: params[:status].present? ? 1 : 0) do |panel| %>
    <% panel.with_fields do %>
      <%= form_with url: search_entity_documents_path(current_entity), method: :get, local: true,
                    data: { turbo_frame: "documents_list" } do %>
        <input type="hidden" name="scope" value="<%= @list_scope %>">
        <input type="hidden" name="q" value="<%= params[:q] %>">
        <input type="hidden" name="classification_node_id" value="<%= params[:classification_node_id] %>">
        <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
        <select name="status" onchange="this.form.requestSubmit()"
                class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
          <option value="">All statuses</option>
          <% Document::STATUSES.each do |status| %>
            <option value="<%= status %>" <%= "selected" if params[:status] == status %>><%= status.titleize %></option>
          <% end %>
        </select>
      <% end %>
    <% end %>
  <% end %>
</div>

<%= turbo_frame_tag "documents_list" do %>
  <% if @documents.any? %>
    <%= render "documents/table", documents: @documents %>

    <div class="mt-4">
      <%= paginate @documents %>
    </div>
  <% else %>
    <%= render Ui::EmptyStateComponent.new(
      title: "No documents found",
      description: "Create a document to start a validation workflow."
    ) %>
  <% end %>
<% end %>
