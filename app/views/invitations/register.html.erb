<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <%= render Ui::CardComponent.new do %>
      <div class="p-8">
        <div class="text-center mb-8">
          <div class="mx-auto h-12 w-12 rounded-full bg-primary-100 flex items-center justify-center mb-4">
            <svg class="h-6 w-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-gray-900">Set up your account</h1>
          <p class="mt-2 text-sm text-gray-600">
            You're joining <strong><%= @entity_user.entity.name %></strong> as <strong><%= @entity_user.role %></strong>.
          </p>
        </div>

        <%= render "devise/shared/error_messages", resource: @user %>

        <%= form_with model: @user,
                      url: invitation_create_account_path(@entity_user.invitation_token),
                      method: :post,
                      builder: FloatingLabelsRails::FormBuilder do |f| %>

          <%= f.floating_text_field :first_name,
                label: "First name",
                required: true,
                autofocus: true,
                autocomplete: "given-name",
                placeholder: " " %>

          <%= f.floating_text_field :last_name,
                label: "Last name",
                required: true,
                autocomplete: "family-name",
                placeholder: " " %>

          <%= f.floating_email_field :email,
                label: "Email",
                value: @entity_user.invited_email,
                disabled: true,
                placeholder: " " %>

          <%= f.floating_password_field :password,
                label: "Password",
                required: true,
                autocomplete: "new-password",
                placeholder: " " %>

          <%= f.floating_password_field :password_confirmation,
                label: "Confirm password",
                required: true,
                autocomplete: "new-password",
                placeholder: " " %>

          <div class="mt-6">
            <%= render Ui::ButtonComponent.new(type: :submit, variant: :primary, class: "w-full") do %>
              Create account & join
            <% end %>
          </div>
        <% end %>

        <p class="mt-4 text-center text-sm text-gray-500">
          Already have an account?
          <%= link_to "Sign in", new_user_session_path, class: "text-primary-600 hover:text-primary-500 font-medium" %>
        </p>
      </div>
    <% end %>
  </div>
</div>
