<%= form_with url: apply_template_entity_document_workflow_steps_path(document.entity, document), method: :post,
              local: true, class: "mt-4 flex items-end gap-3" do %>
  <div class="flex-1">
    <%= label_tag :circuit_template_id, "Apply template", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= select_tag :circuit_template_id, options_from_collection_for_select(circuit_templates, :id, :name),
                   class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
  </div>
  <%= render(Ui::ButtonComponent.new(variant: :secondary)) { "Apply" } %>
<% end %>
