<div class="flex items-center gap-3 py-2.5" data-role="<%= step.role %>">
  <% if manageable? %>
    <span class="drag-handle cursor-grab text-gray-400 shrink-0 select-none" title="Drag to reorder">&#10495;</span>
  <% end %>

  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gray-100 text-xs font-semibold text-gray-700" data-order-badge>
    <%= step.order %>
  </span>

  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 flex-wrap">
      <p class="text-sm font-medium text-gray-900 truncate"><%= step.role %></p>
      <%= render(Ui::BadgeComponent.new(color: status_color)) { step.status.titleize } %>
      <% if step.parallel? %>
        <%= render(Ui::BadgeComponent.new(color: :gray)) { "Group #{step.parallel_group}" } %>
      <% end %>
    </div>
    <p class="text-sm text-gray-600 truncate"><%= step.actor&.email || "Unassigned" %></p>
    <% if step.comment.present? %>
      <p class="mt-1 text-sm text-gray-500 italic truncate">&ldquo;<%= step.comment %>&rdquo;</p>
    <% end %>
  </div>

  <% if manageable? %>
    <%= render(Ui::ButtonComponent.new(
      href: entity_document_workflow_step_path(step.document.entity, step.document, step), variant: :danger, size: :sm, method: :delete,
      data: { turbo_confirm: "Remove this step from the circuit?" }
    )) { "Remove" } %>
  <% end %>
</div>
