<%= render Auth::AuthLayoutComponent.new(
  title: "Two-factor authentication",
  subtitle: "Enter the 6-digit code from your authenticator app"
) do %>
  <% if flash[:alert] %>
    <div class="mb-6 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: two_factor_authentication_path, method: :post, local: true,
                data: { controller: "otp-auto-submit" } do %>
    <div class="mb-2">
      <%= label_tag "otp_attempt", "Authentication code", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= text_field_tag "otp_attempt", nil, required: true, autofocus: true, autocomplete: "one-time-code",
            data: { action: "input->otp-auto-submit#submit" },
            class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
    </div>

    <p class="text-xs text-gray-500 mb-6">
      Lost your device? You can also enter one of your backup codes.
    </p>

    <button type="submit" data-otp-auto-submit-target="submit"
            class="w-full flex justify-center items-center gap-2 py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors cursor-pointer disabled:opacity-75 disabled:cursor-not-allowed">
      <span data-otp-auto-submit-target="label">Verify</span>
      <span data-otp-auto-submit-target="spinner" class="hidden items-center gap-2">
        <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none"/>
          <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
        </svg>
        Verifying…
      </span>
    </button>
  <% end %>
<% end %>
