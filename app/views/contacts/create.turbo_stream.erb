<% if @contact.persisted? %>
  <%= turbo_stream.append params[:picker_id] do %>
    <option value="Contact-<%= @contact.id %>"><%= @contact.display_name %></option>
  <% end %>

  <% Array(params[:additional_picker_ids]).each do |picker_id| %>
    <%= turbo_stream.append picker_id do %>
      <option value="Contact-<%= @contact.id %>"><%= @contact.display_name %></option>
    <% end %>
  <% end %>
<% end %>

<%= turbo_stream.replace "#{params[:picker_id]}_new_contact" do %>
  <%= render(Documents::ContactQuickFormComponent.new(
    entity: current_entity,
    picker_id: params[:picker_id],
    contact: @contact.persisted? ? nil : @contact,
    open: !@contact.persisted?
  )) %>
<% end %>
