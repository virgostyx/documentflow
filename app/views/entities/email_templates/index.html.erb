<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: "Settings", path: entity_settings_path(current_entity) },
    { label: "Email templates" }
  ]) %>
<% end %>

<% content_for :actions do %>
  <% if policy(EmailTemplate.new(entity: current_entity)).create? %>
    <%= render(Ui::ButtonComponent.new(href: new_entity_email_template_path(current_entity))) { "New email template" } %>
  <% end %>
<% end %>

<div class="max-w-3xl">
  <h1 class="text-2xl font-bold text-gray-900 mb-4">Email templates</h1>

  <% if @email_templates.any? %>
    <%= render Ui::CardComponent.new do |card| %>
      <% card.with_header { "All email templates" } %>

      <ul class="divide-y divide-gray-100">
        <% @email_templates.each do |email_template| %>
          <li class="flex items-center justify-between py-3">
            <div>
              <p class="font-medium text-gray-900"><%= email_template.name %></p>
              <p class="text-sm text-gray-600">
                <%= email_template.department&.name || "Entity-wide" %>
                &middot; <%= pluralize(email_template.email_template_fields.size, "field") %>
              </p>
            </div>

            <div class="flex items-center gap-3">
              <% if policy(email_template).update? %>
                <%= render(Ui::ButtonComponent.new(href: edit_entity_email_template_path(current_entity, email_template), variant: :secondary)) { "Edit" } %>
              <% end %>
              <% if policy(email_template).destroy? %>
                <%= render(Ui::ButtonComponent.new(
                  href: entity_email_template_path(current_entity, email_template), variant: :danger, method: :delete,
                  data: { turbo_confirm: "Are you sure you want to delete this email template?" }
                )) { "Delete" } %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% else %>
    <%= render Ui::EmptyStateComponent.new(
      title: "No email templates yet",
      description: "Create a reusable email body with tags to quickly compose dispatch messages."
    ) do |empty_state| %>
      <% empty_state.with_action do %>
        <% if policy(EmailTemplate.new(entity: current_entity)).create? %>
          <%= render(Ui::ButtonComponent.new(href: new_entity_email_template_path(current_entity))) { "New email template" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
