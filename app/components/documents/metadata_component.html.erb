<div class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-gray-600">
  <p><span class="font-medium text-gray-900">From:</span> <%= document.sender&.display_name %> <%= helpers.party_badge(document.sender) %></p>
  <p><span class="font-medium text-gray-900">To:</span> <%= document.addressee&.display_name %> <%= helpers.party_badge(document.addressee) %></p>
  <p><span class="font-medium text-gray-900">Date:</span> <%= l(document.document_date) %></p>
</div>
