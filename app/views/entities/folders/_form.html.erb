<%= form_with model: [ current_entity, folder ], builder: FloatingLabelsRails::FormBuilder, local: true, data: { turbo_frame: "_top" } do |f| %>
  <% if folder.errors.any? %>
    <div class="mb-4 rounded-md bg-danger-50 border border-danger-200 px-4 py-3 text-sm text-danger-700">
      <%= folder.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= f.hidden_field :department_id %>
  <%= f.hidden_field :parent_id %>

  <%= f.floating_text_field :name, label: "Name", required: true, autofocus: true, placeholder: " " %>

  <div class="mt-6 flex justify-end gap-3">
    <%= render(Ui::ButtonComponent.new(variant: :secondary, type: "button", data: { action: "click->modal#close" })) { "Cancel" } %>
    <%= render(Ui::ButtonComponent.new) { folder.persisted? ? "Save changes" : (folder.parent_id.present? ? "Create subfolder" : "Create folder") } %>
  </div>
<% end %>
