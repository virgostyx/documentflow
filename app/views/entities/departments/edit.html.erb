<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%= render Ui::PageHeaderComponent.new(
    title: "Edit department",
    description: current_entity.name,
    back_path: entity_settings_path(current_entity),
    back_text: "Settings"
  ) %>

  <%= render Ui::CardComponent.new do %>
    <%= render "form", department: @department %>
  <% end %>
</div>
