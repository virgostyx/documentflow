<div class="relative inline-block text-left" data-controller="dropdown">
  <button type="button" data-action="click->dropdown#toggle"
          class="inline-flex items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-medium bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors">
    <%= @label %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <div data-dropdown-target="menu" role="menu"
       class="hidden absolute right-0 z-10 mt-2 w-56 origin-top-right rounded-md bg-white shadow-lg border border-gray-200 py-1 focus:outline-none">
    <% items.each do |item| %>
      <%= item %>
    <% end %>
  </div>
</div>
