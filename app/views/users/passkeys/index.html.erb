<%= render Auth::AuthLayoutComponent.new(
  title: "Passkeys",
  subtitle: current_user.passwordless? ? "You sign in with a passkey" : "Sign in without a password, like an SSH key"
) do %>
  <div class="mb-6">
    <%= link_to edit_user_registration_path, class: "inline-flex items-center text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors" do %>
      ← Back to profile
    <% end %>
  </div>

  <% if flash[:alert] %>
    <div class="mb-6 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="mb-6 p-4 rounded-lg bg-green-50 border border-green-200 text-sm text-green-700"><%= flash[:notice] %></div>
  <% end %>

  <% if current_user.passwordless? %>
    <div class="mb-6 flex items-center gap-2 text-sm font-medium text-green-700">
      <span class="inline-block w-2 h-2 rounded-full bg-green-500"></span>
      Password sign-in is disabled for your account
    </div>
  <% end %>

  <% if @webauthn_credentials.any? %>
    <ul class="mb-6 divide-y divide-gray-200 border-t border-b border-gray-200">
      <% @webauthn_credentials.each do |credential| %>
        <li class="py-3 flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-900"><%= credential.nickname %></p>
            <p class="text-xs text-gray-500">
              Added <%= credential.created_at.to_fs(:long) %>
              &middot; Last used <%= credential.last_used_at ? credential.last_used_at.to_fs(:long) : "never" %>
            </p>
          </div>
          <%= button_to passkey_path(credential), method: :delete,
                        class: "text-gray-400 hover:text-red-600 transition-colors cursor-pointer p-1",
                        title: "Remove passkey",
                        aria: { label: "Remove passkey" },
                        data: { turbo_confirm: @webauthn_credentials.size == 1 ?
                          "Remove your only passkey? Password sign-in will become available again for this account." :
                          "Remove this passkey?" } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-gray-500 mb-6">No passkeys registered yet.</p>
  <% end %>

  <div data-controller="passkey-registration"
       data-passkey-registration-options-url-value="<%= options_passkeys_path %>"
       data-passkey-registration-create-url-value="<%= passkeys_path %>">
    <div data-passkey-registration-target="error" class="hidden mb-6 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700"></div>

    <div data-passkey-registration-target="form" class="mb-6 pt-6 border-t border-gray-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Add a passkey</h3>
      <label for="passkey_nickname" class="block text-sm font-medium text-gray-700 mb-1">Name this passkey</label>
      <input type="text" id="passkey_nickname" placeholder="e.g. YubiKey, iPhone"
             data-passkey-registration-target="nickname"
             class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm mb-3 focus:outline-none focus:ring-2 focus:ring-primary-500">
      <button type="button" data-action="passkey-registration#register"
              class="w-full py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 cursor-pointer">
        Add a passkey
      </button>
    </div>

    <div data-passkey-registration-target="backupCodes" class="hidden pt-6 border-t border-gray-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Your recovery codes</h3>
      <p class="text-xs text-gray-500 mb-4">
        Save these codes somewhere safe. Each one can be used once to sign in if you lose access to your passkey.
        They won't be shown again after you leave this page.
      </p>
      <ul data-passkey-registration-target="backupCodesList" class="mb-6 space-y-2"></ul>
      <a data-passkey-registration-target="downloadLink" download
         class="w-full mb-3 flex justify-center py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors cursor-pointer">
        Download codes (.txt)
      </a>
      <button type="button" data-action="passkey-registration#done"
              class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 cursor-pointer">
        Done
      </button>
    </div>
  </div>

  <% if current_user.passwordless? %>
    <div class="pt-6 border-t border-gray-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Manage recovery codes</h3>
      <p class="text-xs text-gray-500 mb-4">
        You have <%= current_user.otp_backup_codes&.size || 0 %> unused recovery code(s).
        Regenerating invalidates any codes you generated before.
      </p>
      <%= button_to "Regenerate recovery codes", two_factor_setup_backup_codes_path, method: :post,
                    class: "w-full py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 cursor-pointer" %>
    </div>
  <% end %>
<% end %>
