<% content_for :title, "#{@document.display_number} - DocumentFlow" %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="flex items-center gap-2 mb-8">
    <%= image_tag "icon.png", class: "w-8 h-8", alt: "" %>
    <span class="text-xl font-bold text-gray-900">DocumentFlow</span>
  </div>

  <p class="text-sm text-gray-600 mb-2">A document was shared with you</p>
  <h1 class="text-2xl font-bold text-gray-900 mb-6"><%= @document.subject %></h1>

  <%= render Ui::CardComponent.new do |card| %>
    <% card.with_header { render(Documents::DocumentStatusBadgeComponent.new(status: @document.status, archived_from_email: @document.archived_from_email?)) } %>

    <%= render Documents::MetadataComponent.new(document: @document) %>

    <div class="mt-6">
      <%= render Ui::DefinitionListComponent.new do |dl| %>
        <% dl.with_item(term: "Reference number") { @document.display_number } %>
        <% dl.with_item(term: "Document date") { l(@document.document_date) } %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-6">
    <%= render Ui::CardComponent.new do |card| %>
      <% card.with_header { "Main document" } %>
      <%= render Documents::MainFileComponent.new(document: @document, current_user: current_user, shared_link: @shared_link) %>
    <% end %>
  </div>

  <div class="mt-6">
    <%= render Ui::CardComponent.new do |card| %>
      <% card.with_header { "Annexes" } %>
      <%= render Documents::AnnexListComponent.new(document: @document, current_user: current_user, shared_link: @shared_link) %>
    <% end %>
  </div>
</div>
