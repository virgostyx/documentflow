<div class="flex items-center gap-3 py-2.5" data-role="<%= step.role %>">
  <% if manageable? %>
    <span class="drag-handle cursor-grab text-gray-400 shrink-0 select-none" title="Drag to reorder">&#10495;</span>
  <% end %>

  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gray-100 text-xs font-semibold text-gray-700" data-order-badge>
    <%= step.order %>
  </span>

  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 flex-wrap">
      <p class="text-sm font-medium text-gray-900 truncate"><%= step.role %></p>
      <%= render(Ui::BadgeComponent.new(color: status_color)) { step.status.titleize } %>
      <% if step.parallel? %>
        <%= render(Ui::BadgeComponent.new(color: :gray)) { "Group #{step.parallel_group}" } %>
      <% end %>
    </div>
    <p class="text-sm text-gray-600 truncate"><%= step.actor&.email || "Unassigned" %></p>
    <% if step.comment.present? %>
      <p class="mt-1 text-sm text-gray-500 italic truncate">&ldquo;<%= step.comment %>&rdquo;</p>
    <% end %>
  </div>

  <% if manageable? %>
    <%= link_to entity_document_workflow_step_path(step.document.entity, step.document, step),
          class: "text-gray-400 hover:text-red-600 transition-colors cursor-pointer p-1", title: "Remove",
          aria: { label: "Remove" },
          data: { turbo_method: :delete, turbo_confirm: "Remove this step from the circuit?" } do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
    <% end %>
  <% end %>
</div>
