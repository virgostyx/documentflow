<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: "Settings", path: entity_settings_path(current_entity) },
    { label: "Document templates", path: entity_document_templates_path(current_entity) },
    { label: @document_template.name }
  ]) %>
<% end %>

<div class="max-w-3xl">
  <h1 class="text-2xl font-bold text-gray-900 mb-4">Edit document template</h1>

  <%= render Ui::CardComponent.new do %>
    <%= render "form", document_template: @document_template %>
  <% end %>
</div>
