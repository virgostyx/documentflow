<% navigation(title: "Queue #{@queue.name}", section: :queues) %>

<div class="space-y-6">
  <%= render "mission_control/jobs/queues/queue_title", queue: @queue %>

  <% if @jobs_page.empty? %>
    <%= blank_status_notice "The queue is empty" %>
  <% else %>
    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Job</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <%= render partial: "mission_control/jobs/queues/job", collection: @jobs_page.records %>
        </tbody>
      </table>
    </div>

    <%= render "mission_control/jobs/shared/pagination_toolbar", page: @jobs_page, filter_param: {} %>
  <% end %>
</div>
