<div class="space-y-3" data-controller="recipients-picker">
  <input type="text" placeholder="Search by name..."
         class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm"
         data-recipients-picker-target="search" data-action="input->recipients-picker#filter">

  <% grouped_parties.each do |group_label, options| %>
    <% next if options.empty? %>

    <div>
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wide"><%= group_label %></p>
      <div class="mt-1 space-y-1">
        <% options.each do |label, token| %>
          <label class="flex items-center gap-2 text-sm text-gray-700"
                 data-recipients-picker-target="row" data-searchable-text="<%= label.downcase %>">
            <%= check_box_tag name, token, false, id: nil, class: "h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded" %>
            <%= label %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <p data-recipients-picker-target="empty" class="hidden text-sm text-gray-500">No matching recipient found.</p>
</div>
