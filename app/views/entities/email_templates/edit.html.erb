<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: "Settings", path: entity_settings_path(current_entity) },
    { label: "Email templates", path: entity_email_templates_path(current_entity) },
    { label: @email_template.name }
  ]) %>
<% end %>

<div class="max-w-3xl">
  <h1 class="text-2xl font-bold text-gray-900 mb-4">Edit email template</h1>

  <%= render Ui::CardComponent.new do %>
    <%= render "form", email_template: @email_template %>
  <% end %>
</div>
