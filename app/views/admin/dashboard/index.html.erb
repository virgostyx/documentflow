<%= render Ui::PageHeaderComponent.new(title: "Admin dashboard") %>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
  <%= render Ui::CardComponent.new do %>
    <p class="text-sm text-gray-500">Users</p>
    <p class="text-2xl font-semibold text-gray-900"><%= @user_count %></p>
  <% end %>

  <%= render Ui::CardComponent.new do %>
    <p class="text-sm text-gray-500">Super admins</p>
    <p class="text-2xl font-semibold text-gray-900"><%= @super_admin_count %></p>
  <% end %>

  <%= render Ui::CardComponent.new do %>
    <p class="text-sm text-gray-500">Entities</p>
    <p class="text-2xl font-semibold text-gray-900"><%= @entity_count %></p>
  <% end %>

  <%= render Ui::CardComponent.new do %>
    <p class="text-sm text-gray-500">Documents</p>
    <p class="text-2xl font-semibold text-gray-900"><%= @document_count %></p>
  <% end %>
</div>

<%= render Ui::CardComponent.new do |card| %>
  <% card.with_header { "Records (read-only)" } %>
  <p class="text-sm text-gray-500 mb-4">Browse the underlying data for models not covered by a curated screen above.</p>
  <div class="flex flex-wrap gap-2">
    <% @record_model_names.each do |model_name| %>
      <%= link_to Admin::ModelRegistry.display_name(model_name), admin_records_path(model: model_name),
            class: "inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200" %>
    <% end %>
  </div>
<% end %>
