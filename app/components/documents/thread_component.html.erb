<ul class="divide-y divide-gray-100">
  <% documents.each do |document| %>
    <li class="py-3 flex items-center justify-between gap-4 <%= "bg-primary-50 -mx-4 px-4 rounded-md" if current?(document) %>">
      <div class="min-w-0">
        <p class="text-sm text-gray-900">
          <% if current?(document) %>
            <span class="font-mono font-medium"><%= document.display_number %></span>
            <%= render(Ui::BadgeComponent.new(color: :primary)) { "Current" } %>
          <% else %>
            <%= link_to document.display_number, entity_document_path(document.entity, document), class: "font-mono text-primary-700 hover:text-primary-800" %>
          <% end %>
        </p>
        <p class="text-sm text-gray-500 truncate"><%= document.subject %></p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <span class="text-sm text-gray-500"><%= l(document.document_date) %></span>
        <%= render Documents::DocumentStatusBadgeComponent.new(status: document.status, archived_from_email: document.archived_from_email?) %>
      </div>
    </li>
  <% end %>
</ul>
