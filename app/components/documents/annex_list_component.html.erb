<% if annexes.any? %>
  <ul class="divide-y divide-gray-100">
    <% annexes.each do |annex| %>
      <li class="flex items-center justify-between py-2 text-sm">
        <span class="text-gray-900">
          <%= annex.file.filename %>
          <% if annex.skip_pdf_conversion? && !show_actions? %>
            <span class="ml-1 text-xs text-gray-400">(original format)</span>
          <% end %>
        </span>
        <div class="flex items-center gap-3">
          <% if show_actions? %>
            <%= form_with url: entity_document_annex_path(document.entity, document, annex), method: :patch, scope: :annex,
                          class: "flex items-center", data: { controller: "auto-submit" } do |f| %>
              <label class="flex items-center gap-1 text-xs text-gray-500" title="Dispatch this annex in its original format instead of converting it to PDF">
                <%= f.check_box :skip_pdf_conversion, { checked: annex.skip_pdf_conversion?, data: { action: "change->auto-submit#submit" } }, "1", "0" %>
                Keep original format
              </label>
            <% end %>
          <% end %>
          <%= link_to preview_url(annex),
                data: { turbo_frame: "modal", action: "click->modal#open" },
                class: "text-gray-400 hover:text-primary-600", title: "Preview" do %>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
          <% end %>
          <%= link_to rails_blob_path(annex.file, disposition: "attachment"),
                class: "text-gray-400 hover:text-primary-600", title: "Download",
                aria: { label: "Download" } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
          <% end %>
          <% if show_actions? %>
            <%= link_to entity_document_annex_path(document.entity, document, annex),
                  class: "text-gray-400 hover:text-red-600 transition-colors cursor-pointer p-1", title: "Remove",
                  aria: { label: "Remove" },
                  data: { turbo_method: :delete, turbo_confirm: "Remove this annex?" } do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            <% end %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-sm text-gray-500">No annexes attached.</p>
<% end %>

<% if show_actions? %>
  <div class="mt-4">
    <%= form_with url: entity_document_annexes_path(document.entity, document), method: :post, local: true,
                  multipart: true, class: "flex items-center gap-3", data: { controller: "auto-submit" } do %>
      <%= file_field_tag "document[annex]",
                         data: { action: "change->auto-submit#submit" },
                         class: "block text-sm text-gray-600 file:mr-4 file:rounded-md file:border-0 file:bg-primary-50 file:px-4 file:py-2 file:text-sm file:font-medium file:text-primary-700 hover:file:bg-primary-100" %>
    <% end %>
  </div>
<% end %>
