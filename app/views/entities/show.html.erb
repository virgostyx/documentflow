<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%= render Ui::PageHeaderComponent.new(
    title: @entity.name,
    description: @entity.code,
    back_path: entities_path,
    back_text: "My entities"
  ) do |header| %>
    <% header.with_actions do %>
      <%= render(Ui::ButtonComponent.new(href: entity_entity_users_path(@entity), variant: :secondary)) { "Members" } %>
      <% if policy(@entity).update? %>
        <%= render(Ui::ButtonComponent.new(href: edit_entity_path(@entity), variant: :secondary)) { "Edit" } %>
      <% end %>
      <% if policy(@entity).destroy? %>
        <%= render(Ui::ButtonComponent.new(
          href: entity_path(@entity), variant: :danger, method: :delete,
          data: { turbo_confirm: "Are you sure you want to delete this entity? This cannot be undone." }
        )) { "Delete" } %>
      <% end %>
    <% end %>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <%= link_to entity_contacts_path(@entity), class: "block bg-white rounded-lg shadow-md border border-gray-200 p-6 text-center hover:border-primary-300 hover:shadow-lg transition-all" do %>
      <p class="text-lg font-semibold text-gray-900">Contacts</p>
      <p class="mt-1 text-3xl font-bold text-primary-600"><%= @entity.contacts.count %></p>
    <% end %>

    <%= link_to entity_documents_path(@entity), class: "block bg-white rounded-lg shadow-md border border-gray-200 p-6 text-center hover:border-primary-300 hover:shadow-lg transition-all" do %>
      <p class="text-lg font-semibold text-gray-900">Documents</p>
      <p class="mt-1 text-3xl font-bold text-primary-600"><%= @entity.documents.count %></p>
    <% end %>
  </div>
</div>
