<nav class="border-b border-gray-200 mb-6">
  <div class="flex gap-6 overflow-x-auto -mb-px">
    <% navigation_sections.each do |key, (label, url)| %>
      <% active = key == current_section %>
      <%= link_to label, url,
            class: "whitespace-nowrap px-1 py-3 text-sm font-medium border-b-2 transition-colors " \
                    "#{active ? "border-primary-600 text-primary-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300"}" %>
    <% end %>
  </div>
</nav>
