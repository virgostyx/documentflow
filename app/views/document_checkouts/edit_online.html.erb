<%= turbo_frame_tag "modal" do %>
  <% if @edit_url %>
    <div class="p-4" data-controller="wopi-editor" data-wopi-editor-origin-value="<%= URI.parse(@edit_url).origin %>">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-900 truncate">Edit online — <%= @document.main_file.filename %></h2>
        <%= render(Ui::ButtonComponent.new(
          href: entity_document_checkout_path(current_entity, @document), variant: :secondary, size: :sm, method: :delete,
          data: { "wopi-editor-target": "doneLink" }
        )) { "Done editing" } %>
      </div>
      <iframe src="<%= @edit_url %>" title="Edit <%= @document.main_file.filename %>"
              class="w-full h-[80vh] rounded border border-gray-200" allowfullscreen></iframe>
      <p class="mt-2 text-xs text-gray-500">
        Your changes are saved automatically as you edit. Click "Done editing" when you're finished to release the document.
      </p>
    </div>
  <% else %>
    <div class="p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-2">Online editor unavailable</h2>
      <p class="text-sm text-gray-500 mb-4">
        The online editor could not be reached for this document. You can still check in a new version manually.
      </p>
      <div class="flex justify-end gap-3">
        <%= render(Ui::ButtonComponent.new(variant: :secondary, type: "button", data: { action: "click->modal#close" })) { "Close" } %>
      </div>
    </div>
  <% end %>
<% end %>
