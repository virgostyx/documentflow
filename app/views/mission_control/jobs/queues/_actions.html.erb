<div class="flex justify-end">
  <% if queue.active? %>
    <%= button_to "Pause", application_queue_pause_path(@application, queue.name), method: :post,
          class: "inline-flex items-center justify-center gap-2 rounded-md px-2.5 py-1 text-xs font-medium transition-colors " \
                 "focus:outline-none focus:ring-2 focus:ring-offset-2 bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 focus:ring-primary-500" %>
  <% else %>
    <%= button_to "Resume", application_queue_pause_path(@application, queue.name), method: :delete,
          class: "inline-flex items-center justify-center gap-2 rounded-md px-2.5 py-1 text-xs font-medium transition-colors " \
                 "focus:outline-none focus:ring-2 focus:ring-offset-2 bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 focus:ring-primary-500" %>
  <% end %>
</div>
