<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: "Settings", path: entity_settings_path(current_entity) },
    { label: "Document templates", path: entity_document_templates_path(current_entity) },
    { label: @document_template.name }
  ]) %>
<% end %>

<div class="max-w-3xl">
  <h1 class="text-2xl font-bold text-gray-900 mb-1">Generate document</h1>
  <p class="text-gray-600 mb-4">From template: <%= @document_template.name %></p>

  <%= render Ui::CardComponent.new do %>
    <%= form_with url: entity_document_template_generation_path(current_entity, @document_template), method: :post,
          local: true, multipart: true, builder: FloatingLabelsRails::FormBuilder, model: @document, scope: :document do |f| %>
      <%= f.floating_date_field :document_date, label: "Document date", required: true, placeholder: " " %>

      <% department_options = current_entity_user.departments.presence || current_entity.departments %>
      <% if department_options.size > 1 %>
        <%= f.floating_select :department_id, department_options.map { |d| [ d.name, d.id ] },
              { selected: @document.department_id, include_blank: "Select a department..." },
              { label: "Department", required: true } %>
      <% else %>
        <%= f.hidden_field :department_id, value: @document.department_id %>
      <% end %>

      <%= render(Documents::PartyPickerComponent.new(
        form: f, attribute: :sender_token, entity: current_entity,
        label: "Sender", required: true, include_blank: "Select a sender...",
        selected: @document.sender_token,
        show_new_contact: false, internal_only: true
      )) %>
      <%= render(Documents::PartyPickerComponent.new(
        form: f, attribute: :addressee_token, entity: current_entity,
        label: "Addressee", required: true, include_blank: "Select an addressee...",
        selected: @document.addressee_token,
        additional_picker_ids: [ "document_sender_token" ]
      )) %>

      <%= render "shared/expects_response_fields", form: f, document: @document %>

      <div class="mt-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">CC recipients (optional)</label>
        <%= select_tag "document[cc_party_tokens][]", party_grouped_options(current_entity, @cc_party_tokens),
              multiple: true,
              class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
        <p class="mt-1 text-xs text-gray-500">Hold Ctrl/Cmd (or Cmd on Mac) to select multiple recipients.</p>
      </div>

      <div class="mt-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">Annexes (optional)</label>
        <%= file_field_tag "document[annexes][]", multiple: true,
              class: "block w-full text-sm text-gray-600 file:mr-3 file:rounded-md file:border-0 file:bg-primary-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-primary-700 hover:file:bg-primary-100" %>
      </div>

      <% if @document_template.document_template_fields.any? %>
        <div class="mt-6 border-t border-gray-200 pt-6">
          <h3 class="text-sm font-medium text-gray-900">Template data</h3>
          <p class="mt-1 text-sm text-gray-500">Fill in the values for this document.</p>

          <div class="mt-4 space-y-4">
            <% @document_template.document_template_fields.ordered.each do |field| %>
              <%= render "shared/template_field_value_input", field: field, value: @field_values[field.tag_name] %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="mt-6 flex justify-end gap-3">
        <%= render(Ui::ButtonComponent.new(href: entity_document_templates_path(current_entity), variant: :secondary)) { "Cancel" } %>
        <%= render(Ui::ButtonComponent.new) { "Generate document" } %>
      </div>
    <% end %>
  <% end %>
</div>
