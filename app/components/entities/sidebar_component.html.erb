<aside class="w-64 bg-white border-r border-gray-200 flex flex-col shrink-0 h-screen sticky top-0">
  <%# Branding %>
  <%= link_to dashboard_path, class: "flex items-center gap-2.5 px-5 py-4 border-b border-gray-100" do %>
    <svg class="w-7 h-7 text-primary-600" fill="currentColor" viewBox="0 0 24 24">
      <path d="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z"/>
    </svg>
    <span class="text-base font-bold text-gray-900 tracking-tight">DocumentFlow</span>
  <% end %>

  <%# Current entity %>
  <div class="px-5 py-3 border-b border-gray-100">
    <% if current_entity.branded? %>
      <div class="flex items-center gap-2">
        <%= image_tag current_entity.logo.variant(resize_to_limit: [48, 48]), class: "w-12 h-12 rounded object-contain shrink-0" %>
        <p class="text-sm font-semibold text-gray-900 truncate"><%= current_entity.acronym %></p>
      </div>
    <% else %>
      <p class="text-sm font-semibold text-gray-900 truncate"><%= current_entity.name %></p>
    <% end %>
    <p class="text-xs text-gray-400 truncate"><%= current_entity.code %></p>

    <% if current_entity_user %>
      <div class="mt-2 flex flex-wrap gap-1">
        <% if unrestricted_access? %>
          <%= render(Ui::BadgeComponent.new(color: :info)) { "All departments" } %>
        <% else %>
          <% departments.each do |department| %>
            <%= render(Ui::BadgeComponent.new(color: department == current_entity_user.primary_department ? :primary : :gray)) do %>
              <% if department.logo.attached? %>
                <%= image_tag department.logo.variant(resize_to_limit: [24, 24]), class: "w-6 h-6 rounded-full object-contain mr-1 -ml-0.5 inline-block align-text-bottom" %>
              <% end %>
              <%= department.name %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%= link_to "Switch entity", entities_path, class: "mt-1 inline-flex items-center text-xs text-primary-600 hover:text-primary-700 transition-colors" %>
  </div>

  <%# Navigation %>
  <nav class="flex-1 flex flex-col min-h-0 px-3 py-4 overflow-y-auto">
    <div class="shrink-0 space-y-0.5" data-controller="sidebar-section" data-sidebar-section-key-value="documents" data-sidebar-section-open-value="true" data-sidebar-section-active-value="<%= documents_section_active? %>">
    <button type="button" data-action="sidebar-section#toggle" class="w-full flex items-center justify-between px-3 pb-1">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Documents</p>
      <svg data-sidebar-section-target="chevron" class="w-4 h-4 text-gray-400 shrink-0 transition-transform duration-150" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
      </svg>
    </button>

    <div data-sidebar-section-target="panel" class="space-y-0.5">
    <%= link_to entity_documents_path(current_entity), class: helpers.nav_class(entity_documents_path(current_entity), exact: true) + " justify-between" do %>
      <span class="flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
        </svg>
        Overview
      </span>
      <%= render(Ui::BadgeComponent.new(color: :gray)) do %><%= overview_count %><% end %>
    <% end %>

    <%= link_to to_validate_entity_documents_path(current_entity), class: helpers.nav_class(to_validate_entity_documents_path(current_entity)) + " justify-between" do %>
      <span class="flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
        </svg>
        To Validate
      </span>
      <%= render(Ui::BadgeComponent.new(color: :gray)) do %><%= to_validate_count %><% end %>
    <% end %>

    <%= link_to received_entity_documents_path(current_entity), class: helpers.nav_class(received_entity_documents_path(current_entity)) + " justify-between" do %>
      <span class="flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776"/>
        </svg>
        My Inbox
      </span>
      <%= render(Ui::BadgeComponent.new(color: :gray)) do %><%= received_count %><% end %>
    <% end %>

    <%= link_to mine_entity_documents_path(current_entity), class: helpers.nav_class(mine_entity_documents_path(current_entity)) + " justify-between" do %>
      <span class="flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
        </svg>
        My Outbox
      </span>
      <%= render(Ui::BadgeComponent.new(color: :gray)) do %><%= mine_count %><% end %>
    <% end %>

    <%= link_to todo_entity_documents_path(current_entity), class: helpers.nav_class(todo_entity_documents_path(current_entity)) + " justify-between" do %>
      <span class="flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
        </svg>
        ToDo
      </span>
      <%= render(Ui::BadgeComponent.new(color: :gray)) do %><%= todo_count %><% end %>
    <% end %>

    <%= link_to waiting_entity_documents_path(current_entity), class: helpers.nav_class(waiting_entity_documents_path(current_entity)) + " justify-between" do %>
      <span class="flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
        </svg>
        Waiting
      </span>
      <%= render(Ui::BadgeComponent.new(color: :gray)) do %><%= waiting_count %><% end %>
    <% end %>

    <%= link_to info_entity_documents_path(current_entity), class: helpers.nav_class(info_entity_documents_path(current_entity)) + " justify-between" do %>
      <span class="flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25h.75v4.5h.75M12 17.25h.007v.008H12v-.008Z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
        </svg>
        Info
      </span>
      <%= render(Ui::BadgeComponent.new(color: :gray)) do %><%= info_count %><% end %>
    <% end %>

    </div>
    </div>

    <div class="shrink-0 space-y-0.5 mt-3" data-controller="sidebar-section" data-sidebar-section-key-value="incoming-mail" data-sidebar-section-open-value="true" data-sidebar-section-active-value="<%= incoming_mail_section_active? %>">
    <button type="button" data-action="sidebar-section#toggle" class="w-full flex items-center justify-between px-3 pb-1">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Incoming Mail</p>
      <svg data-sidebar-section-target="chevron" class="w-4 h-4 text-gray-400 shrink-0 transition-transform duration-150" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
      </svg>
    </button>

    <div data-sidebar-section-target="panel" class="space-y-0.5">
    <%= link_to inbox_entity_incoming_mails_path(current_entity), class: helpers.nav_class(inbox_entity_incoming_mails_path(current_entity)) + " justify-between" do %>
      <span class="flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
        </svg>
        Incoming Inbox
      </span>
      <%= render(Ui::BadgeComponent.new(color: :gray)) do %><%= incoming_inbox_count %><% end %>
    <% end %>

    <%= link_to pending_triage_entity_incoming_mails_path(current_entity), class: helpers.nav_class(pending_triage_entity_incoming_mails_path(current_entity)) + " justify-between" do %>
      <span class="flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15.75h.007v.008H12v-.008Z"/>
        </svg>
        Pending Triage
      </span>
      <%= render(Ui::BadgeComponent.new(color: :gray)) do %><%= pending_triage_count %><% end %>
    <% end %>
    </div>
    </div>

    <% nav_base = "flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium transition-colors" %>
    <% nav_active = "#{nav_base} bg-primary-100 text-primary-700" %>
    <% nav_inactive = "#{nav_base} text-gray-600 hover:bg-primary-50 hover:text-primary-700" %>

    <div class="shrink-0 space-y-0.5 mt-3" data-controller="sidebar-section" data-sidebar-section-key-value="classification" data-sidebar-section-active-value="<%= classification_section_active? %>">
    <div class="pb-1 px-3 flex items-center justify-between">
      <button type="button" data-action="sidebar-section#toggle" class="flex items-center gap-1">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Classification</p>
        <svg data-sidebar-section-target="chevron" class="w-4 h-4 text-gray-400 shrink-0 transition-transform duration-150" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
        </svg>
      </button>
      <%= link_to "Manage", entity_classification_nodes_path(current_entity), class: "text-xs text-primary-600 hover:text-primary-700" %>
    </div>

    <div data-sidebar-section-target="panel" class="space-y-0.5">
    <%= link_to entity_documents_path(current_entity, classification_node_id: "unclassified"), class: (unclassified_active? ? nav_active : nav_inactive) + " justify-between" do %>
      <span>Unclassified</span>
      <%= render(Ui::BadgeComponent.new(color: :gray)) do %><%= unclassified_count %><% end %>
    <% end %>

    <% classification_roots.each do |node| %>
      <%= render Entities::ClassificationNodeRowComponent.new(
            node: node, mode: :sidebar, current_entity: current_entity,
            active_node_id: request.query_parameters["classification_node_id"],
            document_counts: classification_document_counts
          ) %>
    <% end %>
    </div>
    </div>

    <div class="shrink-0 space-y-0.5 mt-3" data-controller="sidebar-section" data-sidebar-section-key-value="contacts" data-sidebar-section-active-value="<%= contacts_section_active? %>">
    <button type="button" data-action="sidebar-section#toggle" class="w-full flex items-center justify-between px-3 pb-1">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Contacts</p>
      <svg data-sidebar-section-target="chevron" class="w-4 h-4 text-gray-400 shrink-0 transition-transform duration-150" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
      </svg>
    </button>

    <div data-sidebar-section-target="panel" class="space-y-0.5">
    <%= link_to entity_contacts_path(current_entity), class: helpers.nav_class(entity_contacts_path(current_entity)) do %>
      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/>
      </svg>
      Overview
    <% end %>
    </div>
    </div>

    <div class="shrink-0 space-y-0.5 mt-3" data-controller="sidebar-section" data-sidebar-section-key-value="settings" data-sidebar-section-active-value="<%= settings_section_active? %>">
    <button type="button" data-action="sidebar-section#toggle" class="w-full flex items-center justify-between px-3 pb-1">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Settings</p>
      <svg data-sidebar-section-target="chevron" class="w-4 h-4 text-gray-400 shrink-0 transition-transform duration-150" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
      </svg>
    </button>

    <div data-sidebar-section-target="panel" class="space-y-0.5">
    <%= link_to entity_settings_path(current_entity), class: helpers.nav_class(entity_settings_path(current_entity)) do %>
      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
      </svg>
      Settings
    <% end %>
    </div>
    </div>
  </nav>

  <%# User section %>
  <div class="px-3 py-3 border-t border-gray-100">
    <div class="flex items-center gap-3 px-2 py-2 rounded-md mb-1">
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-primary-100 text-primary-700 font-medium text-xs shrink-0">
        <%= current_user.email.first.upcase %>
      </span>
      <div class="min-w-0">
        <p class="text-sm font-medium text-gray-700 truncate"><%= current_user.email %></p>
      </div>
    </div>

    <%= link_to destroy_user_session_path, data: { turbo_method: :delete },
          class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm text-gray-500 hover:text-danger-600 hover:bg-danger-50 transition-colors" do %>
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"/>
      </svg>
      Sign out
    <% end %>
  </div>
</aside>
