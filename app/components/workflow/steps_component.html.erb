<%= render Ui::CardComponent.new do |card| %>
  <% card.with_header { "Validation circuit" } %>

  <% if steps.any? %>
    <div class="divide-y divide-gray-100">
      <% steps.each_with_index do |step, index| %>
        <%= render Workflow::StepComponent.new(
          step: step, manageable: manageable?, first: index.zero?, last: index == steps.size - 1
        ) %>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-gray-500">No validation circuit defined for this document yet.</p>
  <% end %>

  <% if manageable? %>
    <%= render Workflow::AddStepFormComponent.new(document: document) %>
    <%= render Workflow::ApplyTemplateFormComponent.new(document: document) %>
  <% end %>
<% end %>
