<%= render Auth::AuthLayoutComponent.new(
  title: "Edit my profile",
  subtitle: "Update your account information"
) do %>
  <div class="mb-6">
    <%= link_to dashboard_path, class: "inline-flex items-center text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors" do %>
      ← Back to dashboard
    <% end %>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
               html: { method: :put },
               builder: FloatingLabelsRails::FormBuilder) do |f| %>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%# Identity %>
    <div class="mb-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Account information</h3>

      <%= f.floating_text_field :first_name,
                                label: "First name",
                                required: true,
                                autocomplete: "given-name",
                                placeholder: " " %>

      <%= f.floating_text_field :last_name,
                                label: "Last name",
                                required: true,
                                autocomplete: "family-name",
                                placeholder: " " %>

      <%= f.floating_email_field :email,
                                 label: "Email address",
                                 required: true,
                                 autocomplete: "email",
                                 placeholder: " " %>

      <%= f.floating_email_field :external_email,
                                 label: "External email (e.g. Outlook, optional)",
                                 autocomplete: "off",
                                 placeholder: " " %>
    </div>

    <% unless current_user.passwordless? %>
      <%# Password %>
      <div class="mb-6 pt-6 border-t border-gray-200">
        <h3 class="text-sm font-semibold text-gray-900 mb-2">Change password</h3>
        <p class="text-xs text-gray-500 mb-4">Leave blank if you don't want to change it</p>

        <%= f.floating_password_field :password,
                                      label: "New password (optional)",
                                      autocomplete: "new-password",
                                      placeholder: " " %>

        <% if @minimum_password_length %>
          <p class="text-xs text-gray-500 -mt-2 mb-4">
            Minimum <%= @minimum_password_length %> characters
          </p>
        <% end %>

        <%= f.floating_password_field :password_confirmation,
                                      label: "Confirm new password",
                                      autocomplete: "new-password",
                                      placeholder: " " %>
      </div>
    <% end %>

    <%# Passkeys %>
    <div class="mb-6 pt-6 border-t border-gray-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Passkeys</h3>
      <p class="text-xs text-gray-500 mb-4">
        <%= current_user.passwordless? ? "Enabled — you sign in with a passkey instead of a password." : "Sign in without a password using a fingerprint, face, or security key." %>
      </p>
      <%= link_to "Manage passkeys", passkeys_path, class: "inline-block text-sm font-medium text-primary-600 hover:text-primary-500" %>
    </div>

    <%# Signature %>
    <div class="mb-6 pt-6 border-t border-gray-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Signature</h3>
      <p class="text-xs text-gray-500 mb-4">
        <%= current_user.signature_image.present? ? "Registered — used to stamp documents you sign." : "Register the image stamped onto documents you sign." %>
      </p>
      <%= link_to "Manage signature", signature_path, class: "inline-block text-sm font-medium text-primary-600 hover:text-primary-500" %>
    </div>

    <%# Two-factor authentication %>
    <div class="mb-6 pt-6 border-t border-gray-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Two-factor authentication</h3>
      <p class="text-xs text-gray-500 mb-4">
        <% if current_user.passwordless? %>
          Not needed — your passkey already satisfies two-factor authentication.
        <% else %>
          <%= current_user.otp_required_for_login? ? "Enabled." : "Not enabled." %>
          <%= current_user.two_factor_required? ? "Mandatory for your role." : "Optional." %>
        <% end %>
      </p>
      <%= link_to "Manage two-factor authentication", two_factor_setup_path,
                  class: "inline-block text-sm font-medium text-primary-600 hover:text-primary-500" %>
    </div>

    <% unless current_user.passwordless? %>
      <%# Current password %>
      <div class="mb-6 pt-6 border-t border-gray-200">
        <h3 class="text-sm font-semibold text-gray-900 mb-2">Confirm changes</h3>
        <p class="text-xs text-gray-500 mb-4">Enter your current password to save the changes</p>

        <%= f.floating_password_field :current_password,
                                      label: "Current password",
                                      required: true,
                                      autocomplete: "current-password",
                                      placeholder: " " %>
      </div>
    <% end %>

    <%# Button %>
    <%= f.submit "Update profile",
                 class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors" %>

    <%# Account deletion %>
    <div class="mt-8 pt-6 border-t border-gray-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Account management</h3>
      <%= link_to "Delete my account",
                  registration_path(resource_name),
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure? This action cannot be undone." },
                  class: "block text-sm text-red-600 hover:text-red-500" %>
    </div>
  <% end %>
<% end %>
