<div class="mt-4" data-controller="checkbox-toggle">
  <div class="flex items-center gap-2">
    <%= form.check_box :expects_response, class: "h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded",
          data: { action: "checkbox-toggle#sync", checkbox_toggle_target: "checkbox" } %>
    <%= form.label :expects_response, "This document expects a response from the recipient", class: "text-sm text-gray-700" %>
  </div>

  <div class="mt-3 <%= "hidden" unless document.expects_response? %>" data-checkbox-toggle-target="panel">
    <%= form.floating_date_field :response_deadline, label: "Response deadline", placeholder: " " %>
  </div>
</div>
