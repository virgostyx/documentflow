<td class="px-4 py-3 text-gray-700"><%= link_to job.queue_name, application_queue_path(@application, job.queue), class: "text-primary-600 hover:text-primary-700" %></td>
<td class="px-4 py-3 text-gray-700">
  <% if job.worker_id %>
    <%= link_to "worker #{job.worker_id}", application_worker_path(@application, job.worker_id), class: "text-primary-600 hover:text-primary-700" %>
  <% else %>
    —
  <% end %>
</td>
<td class="px-4 py-3 text-gray-500"><%= job.started_at ? time_distance_in_words_with_title(job.started_at) : "(Finished)" %></td>
