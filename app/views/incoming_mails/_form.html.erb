<%= form_with model: [ current_entity, document ], url: entity_incoming_mails_path(current_entity), builder: FloatingLabelsRails::FormBuilder, local: true, multipart: true do |f| %>
  <% if document.errors.any? %>
    <div class="mb-4 rounded-md bg-danger-50 border border-danger-200 px-4 py-3 text-sm text-danger-700">
      <%= document.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= f.floating_text_field :subject, label: "Subject", required: true, autofocus: true, placeholder: " " %>
  <%= f.floating_date_field :document_date, label: "Document date", required: true, placeholder: " " %>

  <% department_options = current_entity_user.departments.presence || current_entity.departments %>
  <% default_department_id = document.department_id || current_entity_user.primary_department&.id || current_entity.departments.default.first&.id %>
  <% if department_options.size > 1 %>
    <%= f.floating_select :department_id, department_options.map { |d| [ d.name, d.id ] },
          { selected: default_department_id, include_blank: "Select a department..." },
          { label: "Department", required: true } %>
  <% else %>
    <%= f.hidden_field :department_id, value: default_department_id %>
  <% end %>

  <%= render(Documents::PartyPickerComponent.new(
    form: f, attribute: :sender_token, entity: current_entity,
    label: "Sender", required: true, include_blank: "Select a sender...",
    selected: document.sender_token, internal_only: false
  )) %>

  <%= f.floating_select :lead_user_id, department_member_options(Department.find_by(id: default_department_id)),
        { selected: document.lead_user_id, include_blank: "Select who this mail is assigned to..." },
        { label: "Assign to", required: true } %>

  <div class="mt-4">
    <%= f.label :main_file, "Main document", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.file_field :main_file,
          class: "block text-sm text-gray-600 file:mr-4 file:rounded-md file:border-0 file:bg-primary-50 file:px-4 file:py-2 file:text-sm file:font-medium file:text-primary-700 hover:file:bg-primary-100" %>
  </div>

  <div class="mt-4">
    <%= f.label :annexes, "Annexes (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.file_field :annexes, multiple: true,
          class: "block text-sm text-gray-600 file:mr-4 file:rounded-md file:border-0 file:bg-primary-50 file:px-4 file:py-2 file:text-sm file:font-medium file:text-primary-700 hover:file:bg-primary-100" %>
  </div>

  <div class="mt-6 flex justify-end gap-3">
    <%= render(Ui::ButtonComponent.new(href: entity_incoming_mails_path(current_entity), variant: :secondary)) { "Cancel" } %>
    <%= render(Ui::ButtonComponent.new) { "Register mail" } %>
  </div>
<% end %>
