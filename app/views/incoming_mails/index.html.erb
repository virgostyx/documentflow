<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: "Incoming Mail" }
  ]) %>
<% end %>

<% content_for :actions do %>
  <% if policy(current_entity.documents.new).create? %>
    <%= render(Ui::ButtonComponent.new(href: new_entity_incoming_mail_path(current_entity))) { "Register incoming mail" } %>
  <% end %>
<% end %>

<% if @documents.any? %>
  <%= render "table", documents: @documents %>

  <div class="mt-4">
    <%= paginate @documents %>
  </div>
<% else %>
  <%= render Ui::EmptyStateComponent.new(
    title: "No mail awaiting triage",
    description: "Incoming mail assigned to you as Lead will appear here until you route it."
  ) %>
<% end %>
