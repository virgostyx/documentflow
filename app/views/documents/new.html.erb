<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%= render Ui::PageHeaderComponent.new(
    title: "New document",
    description: current_entity.name,
    back_path: entity_documents_path(current_entity),
    back_text: "Documents"
  ) %>

  <% if current_user.distribution_lists.any? %>
    <div class="mb-6">
      <%= render Ui::CardComponent.new do %>
        <%= form_with url: new_entity_document_path(current_entity), method: :get, local: true, class: "flex items-end gap-3" do %>
          <div class="flex-1">
            <label for="distribution_list_id" class="block text-xs font-medium text-gray-700 mb-1">Load a saved distribution list</label>
            <select name="distribution_list_id" id="distribution_list_id"
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
              <option value="">None</option>
              <% current_user.distribution_lists.order(:name).each do |list| %>
                <option value="<%= list.id %>" <%= "selected" if @document.distribution_list_id.to_s == list.id.to_s %>><%= list.name %></option>
              <% end %>
            </select>
          </div>
          <%= render(Ui::ButtonComponent.new(variant: :secondary, size: :sm)) { "Load" } %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= render Ui::CardComponent.new do %>
    <%= render "form", document: @document %>
  <% end %>
</div>
