<%= form_with model: entity, builder: FloatingLabelsRails::FormBuilder, local: true, multipart: true do |f| %>
  <% if entity.errors.any? %>
    <div class="mb-4 rounded-md bg-danger-50 border border-danger-200 px-4 py-3 text-sm text-danger-700">
      <%= entity.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= f.floating_text_field :name,
                            label: "Entity name",
                            required: true,
                            autofocus: true,
                            placeholder: " " %>

  <div class="mt-4">
    <%= f.floating_text_field :acronym,
                              label: "Acronym",
                              placeholder: " " %>
  </div>

  <div class="mt-4">
    <label class="block text-sm font-medium text-gray-700 mb-1">Logo</label>
    <% if entity.logo.attached? %>
      <%= image_tag entity.logo.variant(resize_to_limit: [64, 64]), class: "w-16 h-16 rounded object-contain mb-2" %>
    <% end %>
    <%= f.file_field :logo, accept: "image/png,image/jpeg,image/svg+xml,image/webp",
                     class: "block w-full text-sm text-gray-600 file:mr-3 file:rounded-md file:border-0 file:bg-primary-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-primary-700 hover:file:bg-primary-100" %>
  </div>

  <div class="mt-6 flex justify-end gap-3">
    <%= render(Ui::ButtonComponent.new(href: entity.persisted? ? entity_path(entity) : entities_path, variant: :secondary)) { "Cancel" } %>
    <%= render(Ui::ButtonComponent.new) { entity.persisted? ? "Save changes" : "Create entity" } %>
  </div>
<% end %>
