<div class="p-4">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-gray-900 truncate"><%= title %></h2>
    <%= render(Ui::ButtonComponent.new(variant: :secondary, type: "button", data: { action: "click->modal#close" })) { "Close" } %>
  </div>
  <div class="relative">
    <div data-modal-target="previewLoader" class="absolute inset-0 flex flex-col items-center justify-center bg-white rounded">
      <svg class="h-8 w-8 animate-spin text-primary-600" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <p class="mt-3 text-sm text-gray-500">Loading document…</p>
    </div>
    <iframe src="<%= preview_content_url %>" title="<%= title %>"
            class="w-full h-[80vh] rounded border border-gray-200"
            data-modal-target="previewFrame"
            data-action="load->modal#hidePreviewLoader"></iframe>
  </div>
</div>
