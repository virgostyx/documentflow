<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b border-gray-200">
      <tr>
        <th class="px-4 py-3 w-10"></th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sortable_column_header("Reference", "reference_number") %></th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sortable_column_header("Subject", "subject") %></th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sender &rarr; Addressee</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sortable_column_header("Date", "document_date") %></th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sortable_column_header("Status", "status") %></th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Response expected</th>
      </tr>
    </thead>
    <%= tag.tbody class: "divide-y divide-gray-100", id: ("documents-overview-table-body" if list_scope == "all") do %>
      <% documents.each do |document| %>
        <%= render Documents::RowComponent.new(document: document, current_user: current_user) %>
      <% end %>
    <% end %>
  </table>
</div>
