<%= form_with model: [ current_entity, department ], builder: FloatingLabelsRails::FormBuilder, local: true do |f| %>
  <% if department.errors.any? %>
    <div class="mb-4 rounded-md bg-danger-50 border border-danger-200 px-4 py-3 text-sm text-danger-700">
      <%= department.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= f.floating_text_field :name, label: "Name", required: true, autofocus: true, placeholder: " " %>

  <div class="mt-6 flex justify-end gap-3">
    <%= render(Ui::ButtonComponent.new(href: entity_settings_path(current_entity), variant: :secondary)) { "Cancel" } %>
    <%= render(Ui::ButtonComponent.new) { department.persisted? ? "Save changes" : "Create department" } %>
  </div>
<% end %>
