<%= render Auth::AuthLayoutComponent.new(
  title: "Distribution lists",
  subtitle: "Reusable named recipient lists you can apply to a document"
) do %>
  <div class="mb-6">
    <%= link_to edit_user_registration_path, class: "inline-flex items-center text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors" do %>
      ← Back to profile
    <% end %>
  </div>

  <% if flash[:alert] %>
    <div class="mb-6 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="mb-6 p-4 rounded-lg bg-green-50 border border-green-200 text-sm text-green-700"><%= flash[:notice] %></div>
  <% end %>

  <% if @distribution_lists.any? %>
    <ul class="mb-6 divide-y divide-gray-200 border-t border-b border-gray-200">
      <% @distribution_lists.each do |list| %>
        <li class="py-3 flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-900"><%= list.name %></p>
            <p class="text-xs text-gray-500"><%= pluralize(list.distribution_list_members.size, "recipient") %></p>
          </div>
          <div class="flex items-center gap-3">
            <%= link_to "Edit", edit_distribution_list_path(list), class: "text-sm font-medium text-primary-600 hover:text-primary-500" %>
            <%= button_to "Delete", distribution_list_path(list), method: :delete,
                          class: "text-sm text-red-600 hover:text-red-500 bg-transparent border-0 p-0 cursor-pointer",
                          data: { turbo_confirm: "Delete this distribution list?" } %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-gray-500 mb-6">No distribution lists yet.</p>
  <% end %>

  <%= link_to "New distribution list", new_distribution_list_path,
              class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 transition-colors" %>
<% end %>
