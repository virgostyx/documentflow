<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: "Settings", path: entity_settings_path(current_entity) },
    { label: "Circuit templates" }
  ]) %>
<% end %>

<% content_for :actions do %>
  <%= render(Ui::ButtonComponent.new(href: new_entity_circuit_template_path(current_entity))) { "New circuit template" } %>
<% end %>

<div class="max-w-3xl">
  <h1 class="text-2xl font-bold text-gray-900 mb-4">Circuit templates</h1>

  <% if @circuit_templates.any? %>
    <%= render Ui::CardComponent.new do |card| %>
      <% card.with_header { "All circuit templates" } %>

      <ul class="divide-y divide-gray-100">
        <% @circuit_templates.each do |circuit_template| %>
          <li class="flex items-center justify-between py-3">
            <div>
              <p class="font-medium text-gray-900"><%= circuit_template.name %></p>
              <p class="text-sm text-gray-600"><%= pluralize(circuit_template.circuit_template_steps.size, "step") %></p>
            </div>

            <div class="flex items-center gap-3">
              <%= render(Ui::ButtonComponent.new(href: edit_entity_circuit_template_path(current_entity, circuit_template), variant: :secondary)) { "Edit" } %>
              <%= render(Ui::ButtonComponent.new(
                href: entity_circuit_template_path(current_entity, circuit_template), variant: :danger, method: :delete,
                data: { turbo_confirm: "Are you sure you want to delete this circuit template?" }
              )) { "Delete" } %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% else %>
    <%= render Ui::EmptyStateComponent.new(
      title: "No circuit templates yet",
      description: "Create a reusable validation circuit template to apply to documents."
    ) do |empty_state| %>
      <% empty_state.with_action do %>
        <%= render(Ui::ButtonComponent.new(href: new_entity_circuit_template_path(current_entity))) { "New circuit template" } %>
      <% end %>
    <% end %>
  <% end %>
</div>
