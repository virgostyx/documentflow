<% list_scope_label = { "mine" => "My Outbox", "received" => "My Inbox", "todo" => "ToDo", "waiting" => "Waiting", "info" => "Info", "to_validate" => "To Validate" }.fetch(@list_scope, "Overview") %>

<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: "Documents", path: entity_documents_path(current_entity) },
    { label: list_scope_label }
  ]) %>
<% end %>

<% content_for :actions do %>
  <% if policy(current_entity.documents.new).create? %>
    <%= render(Ui::ButtonComponent.new(href: new_entity_document_path(current_entity))) { "New document" } %>
  <% end %>
<% end %>

<% active_filter_count = [ params[:status], params[:department_id], params[:date_from], params[:date_to], params[:doc_direction] ].count(&:present?) %>
<%= turbo_frame_tag "documents_list" do %>
<%= render Ui::FilterPanelComponent.new(
  active_count: active_filter_count,
  open: params[:q].present?,
  clear_href: search_entity_documents_path(current_entity, scope: @list_scope, classification_node_id: params[:classification_node_id])
) do |panel| %>
    <% panel.with_search do %>
      <%= form_with url: search_entity_documents_path(current_entity), method: :get, local: true,
                    data: { turbo_frame: "documents_list", controller: "auto-submit" }, class: "flex-1 max-w-md" do %>
        <input type="hidden" name="scope" value="<%= @list_scope %>">
        <input type="hidden" name="classification_node_id" value="<%= params[:classification_node_id] %>">
        <input type="search" name="q" value="<%= params[:q] %>" placeholder="Search documents..."
               data-action="search->auto-submit#submit"
               class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
      <% end %>
    <% end %>

    <% panel.with_fields do %>
      <%= form_with url: search_entity_documents_path(current_entity), method: :get, local: true,
                    data: { turbo_frame: "documents_list" }, class: "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3" do %>
        <input type="hidden" name="scope" value="<%= @list_scope %>">
        <input type="hidden" name="q" value="<%= params[:q] %>">
        <input type="hidden" name="classification_node_id" value="<%= params[:classification_node_id] %>">

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
          <select name="status" onchange="this.form.requestSubmit()"
                  class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
            <option value="">All statuses</option>
            <% Document::STATUSES.each do |status| %>
              <option value="<%= status %>" <%= "selected" if params[:status] == status %>><%= status.titleize %></option>
            <% end %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Department</label>
          <select name="department_id" onchange="this.form.requestSubmit()"
                  class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
            <option value="">All departments</option>
            <% current_entity.departments.order(:name).each do |department| %>
              <option value="<%= department.id %>" <%= "selected" if params[:department_id] == department.id.to_s %>><%= department.name %></option>
            <% end %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Direction</label>
          <select name="doc_direction" onchange="this.form.requestSubmit()"
                  class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
            <option value="">All directions</option>
            <% Document::DIRECTIONS.each do |direction| %>
              <option value="<%= direction %>" <%= "selected" if params[:doc_direction] == direction %>><%= direction.titleize %></option>
            <% end %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">From</label>
          <input type="date" name="date_from" value="<%= params[:date_from] %>" onchange="this.form.requestSubmit()"
                 class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">To</label>
          <input type="date" name="date_to" value="<%= params[:date_to] %>" onchange="this.form.requestSubmit()"
                 class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if @documents.any? %>
    <%= render "documents/table", documents: @documents, list_scope: @list_scope %>

    <div class="mt-4">
      <%= paginate @documents %>
    </div>
  <% else %>
    <%= render Ui::EmptyStateComponent.new(
      title: "No documents found",
      description: "Create a document to start a validation workflow."
    ) %>
  <% end %>
<% end %>
