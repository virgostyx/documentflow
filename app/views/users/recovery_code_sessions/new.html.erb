<%= render Auth::AuthLayoutComponent.new(
  title: "Use a recovery code",
  subtitle: "For when your passkey is no longer available"
) do %>
  <div class="mb-6">
    <%= link_to new_user_session_path, class: "inline-flex items-center text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors" do %>
      ← Back to sign in
    <% end %>
  </div>

  <% if flash[:alert] %>
    <div class="mb-6 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700"><%= flash[:alert] %></div>
  <% end %>

  <%= form_with url: recovery_code_session_path, method: :post, local: true do %>
    <div class="mb-4">
      <%= label_tag "email", "Email address", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= email_field_tag "email", nil, required: true, autocomplete: "email", autofocus: true,
            class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
    </div>
    <div class="mb-6">
      <%= label_tag "recovery_code", "Recovery code", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= text_field_tag "recovery_code", nil, required: true, autocomplete: "one-time-code",
            class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary-500" %>
    </div>
    <%= submit_tag "Sign in", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 cursor-pointer" %>
  <% end %>
<% end %>
