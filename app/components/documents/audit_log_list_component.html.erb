<ul class="divide-y divide-gray-100">
  <% logs.each do |log| %>
    <li class="py-2 text-sm">
      <span class="text-gray-900 font-medium"><%= log.user.display_name %></span>
      <span class="text-gray-600"> <%= description(log) %></span>
      <span class="text-gray-500"> &middot; <%= l(log.created_at, format: :short) %></span>
    </li>
  <% end %>
</ul>
