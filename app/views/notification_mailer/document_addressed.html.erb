<p>Hello <%= @recipient_name %>,</p>

<%= simple_format(@dispatch_message) %>

<% if @files_attached %>
  <% if @include_attachment_note %>
    <p>The document and its attachments are enclosed with this email as PDF files.</p>
  <% end %>
<% else %>
  <p><%= link_to "View the document", @document_url %></p>

  <% if @shared_link %>
    <p>This link will expire on <%= l(@shared_link.expires_at) %>.</p>
  <% end %>
<% end %>
