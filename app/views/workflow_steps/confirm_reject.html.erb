<%= turbo_frame_tag "modal" do %>
  <div class="p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Reject step</h2>

    <p class="text-sm text-gray-500 mb-4">Please provide a reason for rejecting this step.</p>

    <%= form_with url: reject_entity_document_workflow_step_path(current_entity, @document, @workflow_step),
                  method: :post, local: true, data: { turbo_frame: "_top" } do |f| %>
      <div>
        <%= label_tag "reason", "Reason", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= text_area_tag "reason", nil, rows: 3, required: true,
              class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-danger-500" %>
      </div>

      <div class="mt-6 flex justify-end gap-3">
        <%= render(Ui::ButtonComponent.new(variant: :secondary, type: "button", data: { action: "click->modal#close" })) { "Cancel" } %>
        <%= render(Ui::ButtonComponent.new(variant: :danger)) { "Reject" } %>
      </div>
    <% end %>
  </div>
<% end %>
