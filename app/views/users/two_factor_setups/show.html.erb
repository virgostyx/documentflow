<%= render Auth::AuthLayoutComponent.new(
  title: "Two-factor authentication",
  subtitle: current_user.otp_required_for_login? ? "Enabled for your account" : "Scan the QR code with your authenticator app"
) do %>
  <div class="mb-6">
    <%= link_to edit_user_registration_path, class: "inline-flex items-center text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors" do %>
      ← Back to profile
    <% end %>
  </div>

  <% if flash[:alert] %>
    <div class="mb-6 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="mb-6 p-4 rounded-lg bg-green-50 border border-green-200 text-sm text-green-700"><%= flash[:notice] %></div>
  <% end %>

  <% if current_user.otp_required_for_login? %>
    <div class="mb-6 flex items-center gap-2 text-sm font-medium text-green-700">
      <span class="inline-block w-2 h-2 rounded-full bg-green-500"></span>
      Two-factor authentication is enabled
    </div>

    <% if current_user.two_factor_required? %>
      <p class="text-xs text-gray-500 mb-6">
        Your role requires two-factor authentication. It cannot be disabled.
      </p>
    <% end %>

    <div class="mb-6 pt-6 border-t border-gray-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Backup codes</h3>
      <p class="text-xs text-gray-500 mb-4">
        You have <%= current_user.otp_backup_codes&.size || 0 %> unused backup code(s).
        Regenerating invalidates any codes you generated before.
      </p>
      <%= button_to "Regenerate backup codes", two_factor_setup_backup_codes_path, method: :post,
                    class: "w-full py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 cursor-pointer" %>
    </div>

    <% unless current_user.two_factor_required? %>
      <div class="pt-6 border-t border-gray-200">
        <h3 class="text-sm font-semibold text-gray-900 mb-2">Disable two-factor authentication</h3>
        <%= form_with url: two_factor_setup_path, method: :delete, local: true do %>
          <div class="mb-4">
            <%= label_tag "current_password", "Current password", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= password_field_tag "current_password", nil, required: true, autocomplete: "current-password",
                  class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
          </div>
          <%= submit_tag "Disable", class: "w-full py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 cursor-pointer" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <% if current_user.two_factor_required? %>
      <p class="text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-md p-3 mb-6">
        Two-factor authentication is mandatory for your role. Set it up below to continue using DocumentFlow.
      </p>
    <% end %>

    <div class="mb-6 flex justify-center">
      <%= @qr_code_svg.html_safe %>
    </div>

    <p class="text-xs text-gray-500 mb-2">Can't scan the code? Enter this key manually:</p>
    <code class="block mb-6 p-2 bg-gray-50 border border-gray-200 rounded text-sm text-center tracking-wider break-all"><%= @otp_secret %></code>

    <%= form_with url: two_factor_setup_path, method: :post, local: true,
                  data: { controller: "otp-auto-submit" } do %>
      <div class="mb-6">
        <%= label_tag "otp_attempt", "Enter the code from your app to confirm", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= text_field_tag "otp_attempt", nil, required: true, autocomplete: "one-time-code",
              data: { action: "input->otp-auto-submit#submit" },
              class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
      <button type="submit" data-otp-auto-submit-target="submit"
              class="w-full flex justify-center items-center gap-2 py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 cursor-pointer disabled:opacity-75 disabled:cursor-not-allowed">
        <span data-otp-auto-submit-target="label">Enable two-factor authentication</span>
        <span data-otp-auto-submit-target="spinner" class="hidden items-center gap-2">
          <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none"/>
            <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
          </svg>
          Enabling…
        </span>
      </button>
    <% end %>
  <% end %>
<% end %>
