<%= turbo_frame_tag "modal" do %>
  <% if @edit_url %>
    <div class="p-4" data-controller="wopi-editor" data-wopi-editor-origin-value="<%= URI.parse(@edit_url).origin %>" data-modal-wide>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-900 truncate">Edit online — <%= @document.main_file.filename %></h2>
        <div class="flex items-center gap-2 shrink-0">
          <button type="button" class="text-gray-400 hover:text-primary-600 transition-colors cursor-pointer p-1"
                  title="Toggle full page" aria-label="Toggle full page" data-action="click->modal#toggleFullscreen">
            <svg data-modal-target="fullscreenExpandIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
            </svg>
            <svg data-modal-target="fullscreenCollapseIcon" class="hidden h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9L3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5M15 15l5.25 5.25" />
            </svg>
          </button>
          <%= render(Ui::ButtonComponent.new(
            href: entity_document_checkout_path(current_entity, @document), variant: :secondary, size: :sm, method: :delete,
            data: { "wopi-editor-target": "doneLink", turbo_frame: "_top" }
          )) { "Done editing" } %>
        </div>
      </div>
      <iframe data-modal-target="editorFrame" src="<%= @edit_url %>" title="Edit <%= @document.main_file.filename %>"
              class="w-full h-[80vh] rounded border border-gray-200" allowfullscreen></iframe>
      <p class="mt-2 text-xs text-gray-500">
        Your changes are saved automatically as you edit. Click "Done editing" when you're finished to release the document.
      </p>
    </div>
  <% else %>
    <div class="p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-2">Online editor unavailable</h2>
      <p class="text-sm text-gray-500 mb-4">
        The online editor could not be reached for this document. You can still check in a new version manually.
      </p>
      <div class="flex justify-end gap-3">
        <%= render(Ui::ButtonComponent.new(variant: :secondary, type: "button", data: { action: "click->modal#close" })) { "Close" } %>
      </div>
    </div>
  <% end %>
<% end %>
