<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: "Distribution lists" } ]) %>
<% end %>

<% content_for :actions do %>
  <%= render(Ui::ButtonComponent.new(href: new_entity_distribution_list_path(current_entity))) { "New distribution list" } %>
<% end %>

<div class="max-w-5xl">
  <h1 class="text-2xl font-bold text-gray-900 mb-4">Distribution lists</h1>

  <% if @distribution_lists.any? %>
    <%= render Ui::CardComponent.new do |card| %>
      <% card.with_header { "All distribution lists" } %>

      <ul class="divide-y divide-gray-100">
        <% @distribution_lists.each do |list| %>
          <li class="flex items-center justify-between py-3">
            <div>
              <p class="font-medium text-gray-900"><%= list.name %></p>
              <p class="text-sm text-gray-600"><%= pluralize(list.distribution_list_members.size, "recipient") %></p>
            </div>

            <div class="flex items-center gap-3">
              <%= render(Ui::ButtonComponent.new(href: edit_entity_distribution_list_path(current_entity, list), variant: :secondary)) { "Edit" } %>
              <%= render(Ui::ButtonComponent.new(
                href: entity_distribution_list_path(current_entity, list), variant: :danger, method: :delete,
                data: { turbo_confirm: "Are you sure you want to delete this distribution list?" }
              )) { "Delete" } %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% else %>
    <%= render Ui::EmptyStateComponent.new(
      title: "No distribution lists yet",
      description: "Create a distribution list to reuse a group of recipients across documents."
    ) do |empty_state| %>
      <% empty_state.with_action do %>
        <%= render(Ui::ButtonComponent.new(href: new_entity_distribution_list_path(current_entity))) { "New distribution list" } %>
      <% end %>
    <% end %>
  <% end %>
</div>
