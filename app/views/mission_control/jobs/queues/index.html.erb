<% navigation(title: "Queues", section: :queues) %>

<% if @queues.empty? %>
  <%= blank_status_notice "There are no queues" %>
<% else %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Queue</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Pending jobs</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <%= render partial: "mission_control/jobs/queues/queue", collection: @queues %>
      </tbody>
    </table>
  </div>
<% end %>
