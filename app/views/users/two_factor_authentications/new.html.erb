<%= render Auth::AuthLayoutComponent.new(
  title: "Two-factor authentication",
  subtitle: "Enter the 6-digit code from your authenticator app"
) do %>
  <% if flash[:alert] %>
    <div class="mb-6 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: two_factor_authentication_path, method: :post, local: true,
                data: { controller: "otp-auto-submit" } do %>
    <div class="mb-2">
      <%= label_tag "otp_attempt", "Authentication code", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= text_field_tag "otp_attempt", nil, required: true, autofocus: true, autocomplete: "one-time-code",
            data: { action: "input->otp-auto-submit#submit" },
            class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
    </div>

    <p class="text-xs text-gray-500 mb-6">
      Lost your device? You can also enter one of your backup codes.
    </p>

    <%= submit_tag "Verify",
                   class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors cursor-pointer" %>
  <% end %>
<% end %>
