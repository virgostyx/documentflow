<nav class="flex items-center justify-end gap-1 mt-4" role="navigation" aria-label="pagination">
  <span class="px-3 py-1.5 text-sm text-gray-500"><%= page.index %> / <%= page.pages_count || "…" %></span>

  <% if page.first? %>
    <span class="px-3 py-1.5 text-sm font-medium text-gray-300 cursor-not-allowed">Previous</span>
  <% else %>
    <%= link_to "Previous", url_for(page: page.previous_index, **filter_param),
          class: "px-3 py-1.5 text-sm font-medium text-gray-500 hover:text-primary-600 rounded-md hover:bg-gray-100 transition-colors" %>
  <% end %>

  <% if page.last? %>
    <span class="px-3 py-1.5 text-sm font-medium text-gray-300 cursor-not-allowed">Next</span>
  <% else %>
    <%= link_to "Next", url_for(page: page.next_index, **filter_param),
          class: "px-3 py-1.5 text-sm font-medium text-gray-500 hover:text-primary-600 rounded-md hover:bg-gray-100 transition-colors" %>
  <% end %>
</nav>
