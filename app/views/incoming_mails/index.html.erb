<% list_scope_label = { "inbox" => "Incoming Inbox", "pending_triage" => "Pending Triage" }.fetch(@list_scope, "Incoming mail") %>

<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: "Incoming mail", path: inbox_entity_incoming_mails_path(current_entity) },
    { label: list_scope_label }
  ]) %>
<% end %>

<% content_for :actions do %>
  <% if policy(current_entity.documents.new).create? %>
    <%= render(Ui::ButtonComponent.new(href: new_entity_incoming_mail_path(current_entity))) { "Register incoming mail" } %>
  <% end %>
<% end %>

<% if @documents.any? %>
  <%= render "table", documents: @documents %>

  <div class="mt-4">
    <%= paginate @documents %>
  </div>
<% else %>
  <%= render Ui::EmptyStateComponent.new(
    title: "No incoming mail found",
    description: "Register an incoming mail to get started."
  ) %>
<% end %>
