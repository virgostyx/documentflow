<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin — DocumentFlow" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50 font-sans antialiased" data-controller="modal">
    <header class="bg-gray-900 text-white px-6 py-3 flex items-center justify-between sticky top-0 z-20">
      <nav class="flex items-center gap-6 text-sm font-medium">
        <%= link_to "Admin", admin_root_path, class: "font-semibold text-white" %>
        <%= link_to "Users", admin_users_path, class: "text-gray-300 hover:text-white" %>
        <%= link_to "Entities", admin_entities_path, class: "text-gray-300 hover:text-white" %>
        <%= link_to "Audit logs", admin_audit_logs_path, class: "text-gray-300 hover:text-white" %>
      </nav>
      <%= link_to "Back to app", root_path, class: "text-gray-300 hover:text-white text-sm" %>
    </header>

    <%= render "shared/flash" %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <%= render Ui::ModalComponent.new %>
    <%= render Ui::ConfirmModalComponent.new %>
    <%= render Ui::LoadingOverlayComponent.new %>
  </body>
</html>
