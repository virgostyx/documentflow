<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b border-gray-200">
      <tr>
        <th class="px-4 py-3 w-10"></th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sortable_column_header("Reference", "reference_number") %></th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sortable_column_header("Subject", "subject") %></th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sender &rarr; Addressee</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sortable_column_header("Date", "document_date") %></th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sortable_column_header("Status", "status") %></th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Response expected</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% documents.each do |document| %>
        <tr class="hover:bg-gray-50 transition-colors cursor-pointer"
            data-controller="row-link context-menu"
            data-row-link-url-value="<%= entity_document_path(current_entity, document) %>"
            data-action="click->row-link#navigate contextmenu->context-menu#open">
          <td class="px-4 py-3">
            <% if document.main_file.attached? %>
              <%= link_to preview_entity_document_main_file_path(current_entity, document),
                    data: { turbo_frame: "modal", action: "click->modal#open" },
                    class: "text-gray-400 hover:text-primary-600", title: "Preview main document" do %>
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                </svg>
              <% end %>
            <% end %>
          </td>
          <td class="px-4 py-3">
            <%= link_to document.reference_number, entity_document_path(current_entity, document), class: "font-mono text-primary-700 hover:text-primary-800", data: { turbo_frame: "_top" } %>
          </td>
          <td class="px-4 py-3 text-gray-900"><%= document.subject %></td>
          <td class="px-4 py-3 text-gray-500"><%= document.sender&.display_name %> &rarr; <%= document.addressee&.display_name %></td>
          <td class="px-4 py-3 text-gray-500"><%= l(document.document_date) %></td>
          <td class="px-4 py-3"><%= render Documents::DocumentStatusBadgeComponent.new(status: document.status) %></td>
          <td class="px-4 py-3">
            <div class="flex items-center gap-2">
              <% if document.expects_response? %>
                <%= render(Ui::BadgeComponent.new(color: :info)) { "Yes" } %>
                <% if document.response_deadline.present? %>
                  <% if document.deadline_overdue? %>
                    <%= render(Ui::BadgeComponent.new(color: :danger)) { "Due #{l(document.response_deadline)}" } %>
                  <% elsif document.deadline_due_tomorrow? %>
                    <%= render(Ui::BadgeComponent.new(color: :warning)) { "Due #{l(document.response_deadline)}" } %>
                  <% else %>
                    <span class="text-xs text-gray-500">Due <%= l(document.response_deadline) %></span>
                  <% end %>
                <% end %>
              <% end %>
              <% if document.awaiting_response_from?(current_user) %>
                <%= link_to "Reply", new_entity_document_path(current_entity, reply_to: document.id),
                      class: "inline-flex items-center rounded-md bg-primary-600 px-2 py-1 text-xs font-medium text-white hover:bg-primary-700",
                      data: { turbo_frame: "_top" } %>
              <% end %>
            </div>

            <div data-context-menu-target="menu" class="hidden fixed z-50 w-56 rounded-md bg-white shadow-lg border border-gray-200 py-1">
              <%= link_to "Classify...", classify_form_entity_document_path(current_entity, document),
                    data: { turbo_frame: "modal", action: "click->modal#open" },
                    class: "block w-full text-left px-3 py-2 text-sm hover:bg-gray-50" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
